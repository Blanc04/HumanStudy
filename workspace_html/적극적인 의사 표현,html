
<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>적극적인 의사 표현 - 참여용</title>
    <style>
        h1 {
            text-align: center;
        }

        #vote {
            height: 200px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
            padding: 0 30px;

            text-align: center;
            font-size: 20px;
        }

        #vote>div {
            cursor: pointer;
            max-width: 30%;

            flex-grow: 1;
        }

        #vote .btn {
            width: 100%;
            height: 150px;
            line-height: 150px;
            /* border: 1px solid black; */
            border-radius: 50%;
            margin-bottom: 10px;

            background-position: center center;
            background-size: contain;
            background-repeat: no-repeat;

        }

        #btn_vote_1 {
            background-image: url("./assets/image/positive.webp");
        }

        #btn_vote_2 {
            background-image: url("./assets/image/normal.webp");
        }

        #btn_vote_3 {
            background-image: url("./assets/image/negative.png");
        }

        #btn_speed_1 {
            background-color: #006b3ebb;
            color: #ffffff;
        }

        #btn_speed_2 {
            background-color: #ffaa1cbb;
        }

        #btn_speed_3 {
            background-color: #ed2938bb;
            color: #ffffff;
        }

        #speed {
            height: 100px;
            display: flex;
            justify-content: space-evenly;
            align-items: center;
            margin-bottom: 40px;
            padding: 0 30px;
        }

        #speed .btn {
            width: 100px;
            height: 75px;
            line-height: 75px;
            text-align: center;
            border-radius: 10%;

            cursor: pointer;
        }

        #write {
            box-sizing: border-box;
            width: 100%;
            margin: 10px 0;
            padding: 0 30px;
        }

        #write textarea {
            width: 100%;
            height: 100%;
            margin-top: 10px;
        }

        #write .btn_write {
            text-align: right;
        }

        #write #opinion {
            background-color: #ffaa1cbb;
            padding: 10px;
            margin-top: 10px;
        }

        #write #opinion .article {
            margin: 10px 0;
            border-bottom: 1px black dotted;
            display: flex;
            align-items: flex-start;
        }

        #write #opinion .article .time {
            margin-right: 10px;
            font-size: 12px;
            line-height: 16px;
            color: white;
            background-color: #69a850;
            padding: 2px;
        }

        #write #opinion .article .msg {
            flex-grow: 1;
            word-break: break-all;

            display: flex;
            justify-content: center;
            flex-direction: column;
        }

        #write #opinion .article .like {
            user-select: none;
            min-width: 50px;
            cursor: pointer;
            position: relative;
            z-index: 1000;
        }

        #write #opinion .article .like .like-count {
            margin-left: 5px;
            display: inline-block;
            width: 22px;
            text-align: right;
        }

        .floating-heart {
            position: absolute;
            color: red;
            font-size: 20px;
            animation: float 2s linear forwards;
            user-select: none;
        }

        @keyframes float {
            0% {
                opacity: 1;
                transform: translate(0, 0) scale(1);
            }

            30% {
                opacity: 0.5;
                transform: translate(10px, -33px) scale(1.3);
            }

            60% {
                opacity: 0.5;
                transform: translate(-5px, -60px) scale(1.6);
            }

            100% {
                opacity: 0;
                transform: translate(5px, -100px) scale(2);
            }
        }

        .vote {
            box-sizing: border-box;
            width: 100%;
            margin-bottom: 10px;
            padding: 0 60px;

            display: none;
        }

        .vote ul {
            padding: 0;
        }

        .vote ul li {
            list-style: none;
            width: 40%;
            margin: 10px 0;
            border: 1px dotted green;
        }

        .vote ul li .val {
            padding-left: 20px;
        }

        .canvas {
            display: none;
            margin-bottom: 10px;
            line-height: 35px;
        }

        .wrap_canvas {
            text-align: center;
        }

        #canvas {
            /* width: 500px;
            height: 500px; */
            border: 1px solid black;
        }

        #color {
            margin: 0 10px;
            padding: 0;
            display: inline-block;
        }

        #color li {
            display: inline-block;
            box-sizing: border-box;
            list-style: none;
            width: 20px;
            height: 20px;
            border: 1px solid black;
            cursor: pointer;
            vertical-align: middle;
        }

        .hidden {
            height: 100%;
            min-height: 100%;
            overflow: hidden !important;
            touch-action: none;
        }

        img,
        iframe {
            max-width: 100%;
        }
    </style>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.1/jquery-ui.min.js"></script>
    <script src="./assets/js/jquery.ui.touch-punch.js"></script>
    <script src="./assets/js/vote.js"></script>
</head>

<body>
    <h1>적극적인 의사 표현 - 참여용</h1>
    <div class="btns">
        <!-- 투표 버튼 -->
        <div id="vote">
            <div class="btn_vote" data-value="vote_1">
                <div id="btn_vote_1" class="btn"></div>
                <div class="txt_vote_1">1번 (긍정)</div>
            </div>
            <div class="btn_vote" data-value="vote_2">
                <div id="btn_vote_2" class="btn"></div>
                <div class="txt_vote_2">2번 (긍정)</div>
            </div>
            <div class="btn_vote" data-value="vote_3">
                <div id="btn_vote_3" class="btn"></div>
                <div class="txt_vote_3">3번 (부정)</div>
            </div>
        </div>

        <!-- 진행 속도 조절 버튼 -->
        <!-- <div id="speed">
            <div id="btn_speed_1" class="btn btn_vote txt_speed_1" data-value="speed_1">다시한번</div>
            <div id="btn_speed_2" class="btn btn_vote txt_speed_2" data-value="speed_2">천천히</div>
            <div id="btn_speed_3" class="btn btn_vote txt_speed_3" data-value="speed_3">정지</div>
        </div> -->
    </div>
    <div class="canvas wrap_canvas">
        <div>
            <canvas id="canvas"></canvas>
        </div>
        <div class="canvas">
            크기 : <select id="canvasSize">
                <option value="200">작게</option>
                <option value="350" selected="selected">보통</option>
                <option value="500">크게</option>
            </select>
            선굵기 : <select id="canvasBold">
                <option value="1">1</option>
                <option value="2" selected="selected">2</option>
                <option value="4">4</option>
                <option value="6">6</option>
            </select>
            <ul id="color">
                <li style="background-color: black;" data-color="black"> </li>
                <li style="background-color: red;" data-color="red"> </li>
                <li style="background-color: green;" data-color="green"> </li>
                <li style="background-color: blue;" data-color="blue"> </li>
                <li style="background-color: violet;" data-color="violet"> </li>
                <li style="background-color: lime;" data-color="lime"> </li>
                <li style="background-color: skyblue;" data-color="skyblue"> </li>
                <li style="background-color: white;" data-color="white"> </li>
                <li style="background-color: #ffc159;" data-color="#ffc159"> </li>
            </ul>
            <button id="clearCanvas" type="button">모두 지우기</button>
            <button id="sendCanvas" type="button">그림 전송</button>
        </div>
    </div>
    <!-- 투표 -->
    <div class="vote">
        항목을 클릭하여 투표해주세요
        <div id="voteList">

        </div>
    </div>

    <!-- 글쓰기 -->
    <div id="write">
        <div class="btn_write">
            <a href="ojummur.html" target="_blank" style="font-size:0; margin-right:6px;">
                <button id="ojummur" type="button">오점뭐</button>
            </a>
            <button id="viewCanvas" type="button">그리기 표시</button>
            <button id="send_txt" type="button">글쓰기</button>
        </div>
        <div>
            <textarea id="txt" rows="4" cols="70"></textarea>
        </div>
        <div class="btn_write">
        </div>
        <div id="opinion">
        </div>
    </div>
</body>

</html>